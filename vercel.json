{
  "version": 2,
  "functions": {
    "api/index.js": {
      "runtime": "@vercel/node@20.x"
    },
    "api/weather.js": {
      "runtime": "@vercel/node@20.x"
    }
  },
  "routes": [
    {
      "src": "/api/weather",
      "dest": "/api/weather.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
